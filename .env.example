# Copy to .env and adjust. Everything has a default; the skeleton runs with none.
# Authoritative list: src/lha/config.py (Config.from_env).

# --- Loop budget -----------------------------------------------------------
LHA_MAX_STEPS=20
LHA_MAX_REPAIRS=3
# Wall-clock and model-call budgets. 0 or unset = unlimited; exceeding either
# PAUSES the run (checkpointed, resumable) instead of failing it.
# LHA_DEADLINE_S=1800
# LHA_MAX_LLM_CALLS=200

# --- LLM backend: stub | claude_cli | codex_cli | anthropic -----------------
# `stub` is deterministic and offline — keep it for tests and `lha eval`.
LHA_LLM_BACKEND=stub
# LHA_CLAUDE_CLI=claude
# Pin a FULL model snapshot for reproducible runs; a floating alias makes
# results uncomparable across days.
# LHA_CLAUDE_MODEL=claude-haiku-4-5-20251001
# LHA_CODEX_CLI=codex
# LHA_CODEX_MODEL=<pinned-model-id>
# LHA_CODEX_EFFORT=medium
# Protocol/service-transient retries only; set to 0 for scored benchmark tasks.
# LHA_CODEX_MAX_RETRIES=2
# LHA_CODEX_RETRY_BACKOFF_S=1
# Defaults to read-only. danger-full-access is rejected unless the process is
# already inside a disposable outer sandbox and the second flag is explicit.
# LHA_CODEX_SANDBOX=read-only
# LHA_CODEX_EXTERNAL_SANDBOX=0
# LHA_ANTHROPIC_MODEL_IMPL=claude-opus-4-8
# LHA_ANTHROPIC_MODEL_ORCH=claude-sonnet-4-6
# ANTHROPIC_API_KEY=...        # only for the 'anthropic' backend

# --- Where target / model-influenced code executes -------------------------
# trusted-local: host interpreter, scrubbed env, process-group kill. NOT a
#   sandbox against hostile code — for this repo's own dev loop and self-eval.
# docker: --network none, empty env, memory/pids caps, read-only mounts.
#   Required for external target repos. The image must carry pytest/ruff;
#   python:3.12-slim does not (see SECURITY.md).
LHA_EXEC_BACKEND=trusted-local
LHA_EXEC_IMAGE=python:3.12-slim

# --- Context / retrieval ---------------------------------------------------
# Code search backend: auto | ccc | null
LHA_CODE_BACKEND=auto
LHA_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Context older than this (seconds) is treated as stale.
LHA_FRESHNESS_MAX_AGE_S=3600

# --- Behavior toggles ------------------------------------------------------
# Run a step's verifiers concurrently.
LHA_PARALLEL_VERIFY=1
# Distil verified successes into retrievable skill notes under data/skills/.
LHA_SKILL_MEMORY=1
# Let a real LLM backend replan instead of the deterministic template. Off by
# default so the stub / `lha eval` path stays reproducible.
LHA_DYNAMIC_PLANNING=0

# --- Paths ----------------------------------------------------------------
LHA_RUNS_DIR=runs
LHA_DATA_DIR=data
